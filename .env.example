# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WE ONBOARD API BASE URL (Hostinger PHP backend)
# Hostinger subdomain document root for api.weonboard.in is public_html/api/
# Canonical endpoint path is https://api.weonboard.in/v1
VITE_API_BASE_URL="https://api.weonboard.in/v1"
VITE_APP_ENV="development"
